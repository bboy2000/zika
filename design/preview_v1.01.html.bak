<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>zika 字卡 · UI 设计稿 v1.01</title>
<style>
:root{
  --c-primary:#D94F3D; --c-primary-deep:#B53A2B; --c-primary-light:#FBE7E3; --c-primary-wash:#FDF3F0;
  --c-gold:#F2B230; --c-gold-deep:#D9941C; --c-gold-light:#FEF4DE; --c-gold-soft:#FDF6E6;
  --c-bg:#FDF9F3; --c-surface:#FFFFFF; --c-text:#2B2B2B; --c-text-2:#5C574F; --c-text-3:#8A8378;
  --c-line:#EDE6DA; --c-line-soft:#F5EFE5;
  --c-grid:#E3B3AA; --c-py:#B9C6D6;
  --c-success:#57A88F; --c-success-light:#E8F4F0; --c-warn:#E8A33D; --c-warn-light:#FDF2E0;
  --sh-sm:0 1px 2px rgba(43,43,43,.04);
  --sh-md:0 2px 8px rgba(43,43,43,.06),0 1px 2px rgba(43,43,43,.04);
  --sh-lg:0 8px 24px rgba(43,43,43,.10),0 2px 6px rgba(43,43,43,.05);
  --sh-gold:0 4px 14px rgba(242,178,48,.32);
  --ease:cubic-bezier(.34,1.56,.64,1);
  --font:"PingFang SC","HarmonyOS Sans SC","Source Han Sans SC","Noto Sans CJK SC","Microsoft YaHei",system-ui,sans-serif;
  /* 汉字专用：楷体栈（预览用系统楷体；小程序内需 wx.loadFontFace，见第 6 节） */
  --kai:"Kaiti SC","STKaiti","KaiTi","楷体","KaiTi_GB2312","Noto Serif SC",serif;
  /* 拼音专用：需良好的声调符号支持 */
  --pyfont:Arial,Helvetica,"Helvetica Neue",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased}
body{
  font-family:var(--font); background:#F7F2E9; color:var(--c-text);
  padding:40px 32px 80px; line-height:1.6;
  background-image:radial-gradient(rgba(43,43,43,.035) 1px, transparent 1px);
  background-size:16px 16px;
}
.wrap{max-width:1340px;margin:0 auto}

/* ---------- 文档头 ---------- */
.doc-head{margin-bottom:40px}
.doc-head .kicker{font-size:12px;letter-spacing:2px;color:var(--c-primary);font-weight:600;margin-bottom:10px}
.doc-head h1{font-size:34px;font-weight:700;letter-spacing:-.5px;margin-bottom:10px}
.doc-head h1 em{font-style:normal;color:var(--c-primary)}
.doc-head p{font-size:15px;color:var(--c-text-2);max-width:820px}
.doc-head .meta{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}

/* ---------- 分区标题 ---------- */
.sec{margin:52px 0 22px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.sec .num{font-size:12px;font-weight:700;color:#fff;background:var(--c-primary);
  width:22px;height:22px;border-radius:7px;display:grid;place-items:center;flex:none}
.sec h2{font-size:19px;font-weight:600}
.sec .note{font-size:13px;color:var(--c-text-3)}

/* ---------- 色板 ---------- */
.palette{display:grid;grid-template-columns:repeat(auto-fill,minmax(146px,1fr));gap:12px}
.sw{border-radius:14px;overflow:hidden;background:#fff;box-shadow:var(--sh-sm);border:1px solid var(--c-line-soft)}
.sw .chip{height:70px;display:grid;place-items:end start;padding:10px}
.sw .chip span{font-size:11px;font-weight:600;letter-spacing:.4px}
.sw .info{padding:9px 11px 11px}
.sw .info b{display:block;font-size:12.5px;font-weight:600}
.sw .info code{font-size:11px;color:var(--c-text-3);font-family:ui-monospace,monospace}

/* ---------- 设备框 ---------- */
.stage{display:flex;gap:34px;flex-wrap:wrap;align-items:flex-start}
.devices{display:flex;gap:34px;flex-wrap:wrap;align-items:flex-start}
.phone{width:375px;height:748px;flex:none;background:#221F1C;border-radius:46px;padding:11px;
  box-shadow:0 24px 60px rgba(43,43,43,.22),0 2px 6px rgba(43,43,43,.12);position:relative}
.phone .screen{width:100%;height:100%;border-radius:36px;overflow:hidden;background:var(--c-bg);
  display:flex;flex-direction:column;position:relative}
.tablet{width:486px;height:648px;flex:none;background:#221F1C;border-radius:26px;padding:16px;
  box-shadow:0 24px 60px rgba(43,43,43,.22);overflow:hidden}
.tablet .screen{width:810px;height:1080px;border-radius:12px;overflow:hidden;background:var(--c-bg);
  transform:scale(.56);transform-origin:top left;position:relative;display:flex;flex-direction:column}
.cap{margin-top:14px;text-align:center;font-size:12px;color:var(--c-text-3);letter-spacing:.5px;max-width:375px}

/* ---------- 手机内页通用 ---------- */
.statusbar{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;
  font-size:12px;font-weight:600;color:var(--c-text);flex:none}
.navbar{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;flex:none}
.navbar .title{font-size:16px;font-weight:600}
.navbar .sub{font-size:12.5px;color:var(--c-text-3)}
.navbar .back{width:28px;height:28px;display:grid;place-items:center;font-size:20px;color:var(--c-text-2)}
.body-scroll{flex:1;overflow:hidden;padding:0 14px 10px}
.tabbar{height:56px;flex:none;background:#fff;border-top:1px solid var(--c-line-soft);display:flex;padding-bottom:4px}
.tabbar .tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  font-size:10.5px;color:var(--c-text-3)}
.tabbar .tab.on{color:var(--c-primary);font-weight:600}
.tabbar .ico{font-size:17px;line-height:1}

/* ---------- 拼音四线三格（唯一正确实现） ----------
   四线 = border-top + 2 条渐变线 + border-bottom
   三格 = 上格(声调) / 中格(主字母) / 下格(下伸)
   基线压在第 3 线上：bottom 微调 —— 文字绝不能有背景色，否则会盖掉格线 */
.pg{display:inline-flex;align-items:flex-start;position:relative;padding:0 7px;border-radius:2px;
  vertical-align:middle;border-top:1px solid var(--c-py);border-bottom:1px solid var(--c-py);
  background-clip:padding-box;
  background-image:linear-gradient(to bottom,
    transparent 0, transparent calc(33.333% - .5px), var(--c-py) calc(33.333% - .5px),
    var(--c-py) calc(33.333% + .5px), transparent calc(33.333% + .5px),
    transparent calc(66.667% - .5px), var(--c-py) calc(66.667% - .5px),
    var(--c-py) calc(66.667% + .5px), transparent calc(66.667% + .5px));
}
/* i 必须无背景色，否则会盖掉格线；x-height 正好填满中格，基线压在第 3 线上 */
.pg i{font-style:normal;font-family:var(--pyfont);font-weight:500;color:#2B2F36;
  white-space:nowrap;position:relative;letter-spacing:.2px}
.pg.sm{height:28px} .pg.sm i{font-size:16.5px;line-height:26px;top:-1.4px}
.pg.md{height:36px} .pg.md i{font-size:21.5px;line-height:34px;top:-1.8px}
.pg.lg{height:46px} .pg.lg i{font-size:28px;line-height:44px;top:-2.4px}
.py-sep{color:#B8B0A4;font-size:12px;margin:0 1px;font-family:var(--pyfont)}

/* 发音按钮 */
.spk{width:26px;height:26px;border-radius:50%;border:1.5px solid #EBCB8A;background:var(--c-gold-soft);
  color:#8A6420;display:inline-grid;place-items:center;flex:none;cursor:pointer}
.spk svg{width:13px;height:13px;display:block}
.spk.on{background:var(--c-gold);border-color:var(--c-gold);color:#fff}
.spk.lg{width:32px;height:32px;border-width:1.5px}
.spk.lg svg{width:15px;height:15px}

/* ---------- 列表顶部概览 ---------- */
.overview{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--c-line-soft);
  border-radius:14px;padding:10px 12px;box-shadow:var(--sh-sm);margin-bottom:12px}
.ring{width:40px;height:40px;border-radius:50%;flex:none;position:relative;
  background:conic-gradient(var(--c-primary) 0 32%, var(--c-line-soft) 32% 100%)}
.ring::after{content:"";position:absolute;inset:4px;background:#fff;border-radius:50%}
.ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:11px;font-weight:700;z-index:1;color:var(--c-primary)}
.ov-txt{flex:1;min-width:0}
.ov-txt .l1{font-size:13.5px;font-weight:600}
.ov-txt .l2{font-size:11px;color:var(--c-text-3);margin-top:1px}
.streak{display:flex;align-items:center;gap:3px;background:var(--c-gold-light);border-radius:999px;
  padding:4px 9px;font-size:12px;font-weight:700;color:var(--c-gold-deep);flex:none}

/* ---------- 课次 + 字卡网格 ---------- */
.lesson-head{display:flex;align-items:center;justify-content:space-between;margin:2px 0 8px}
.lesson-head .ln{font-size:13px;font-weight:600;color:var(--c-text-2)}
.lesson-head .cnt{font-size:11px;color:var(--c-text-3)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}

/* 字卡：大字 → 四线三格拼音+发音 → 组词 */
.cc{background:#fff;border:1px solid var(--c-line-soft);border-radius:14px;padding:10px 8px 9px;
  display:flex;flex-direction:column;align-items:center;gap:4px;box-shadow:var(--sh-sm);
  position:relative;overflow:hidden}
.cc .zi{font-family:var(--kai);font-size:52px;font-weight:400;line-height:1.08;color:var(--c-text)}
.cc .pyrow{display:flex;align-items:center;gap:5px}
.cc .ws{display:flex;gap:4px;flex-wrap:nowrap;overflow:hidden;max-width:100%;margin-top:1px}
.cc .ws span{font-size:10.5px;color:#7A7465;background:var(--c-gold-soft);border:1px solid #F0DFBC;
  border-radius:999px;padding:0 6px;line-height:16px;white-space:nowrap}
.cc .done{position:absolute;top:7px;right:7px;width:8px;height:8px;border-radius:50%;background:var(--c-success)}
.cc .newf{position:absolute;top:6px;left:7px;font-size:9px;font-weight:700;color:var(--c-primary);
  background:var(--c-primary-light);border-radius:4px;padding:0 4px;line-height:14px}

/* ---------- 详情页 ---------- */
/* 书写区：拼音 / 田字格 / 笔顺分解 收进一个面板，紧凑、成组 */
.write-panel{background:#fff;border:1px solid var(--c-line-soft);border-radius:16px;
  padding:10px 12px 12px;box-shadow:var(--sh-sm);display:flex;flex-direction:column;align-items:center}
.wp-top{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:8px}
.wp-tag{font-size:11px;color:var(--c-text-3)}

.tz{width:166px;height:166px;background:#FFFDFA;border:1.5px solid var(--c-grid);border-radius:5px;
  position:relative;display:grid;place-items:center;flex:none}
.tz::before,.tz::after{content:"";position:absolute;border-color:var(--c-grid);border-style:dashed;opacity:.65}
.tz::before{left:0;right:0;top:50%;border-width:0 0 1px 0}
.tz::after{top:0;bottom:0;left:50%;border-width:0 1px 0 0}
.tz .zi{font-family:var(--kai);font-size:126px;font-weight:400;line-height:1;color:var(--c-text);
  position:relative;z-index:1}
.tz .ghost{font-family:var(--kai);font-size:126px;font-weight:400;line-height:1;color:#EFE8DC;position:relative;z-index:1}

/* 笔顺分解：逐笔累加，紧贴动画下方，同宽对齐 */
.strokes{display:flex;gap:5px;margin-top:9px;width:166px}
.strokes .st{flex:1;aspect-ratio:1;background:#FFFDFA;border:1px solid var(--c-line);
  border-radius:3px;display:grid;place-items:center;position:relative}
.strokes .st .zi{font-family:var(--kai);font-size:34px;line-height:1;color:#5C574F}
.strokes .st .n{position:absolute;right:3px;top:2px;font-size:8.5px;color:#B6AC9E;line-height:1}
.strokes .st.play{border-color:var(--c-primary);border-style:dashed;color:var(--c-primary)}
.strokes .st.play .zi{color:var(--c-primary)}
.wp-foot{display:flex;align-items:center;gap:10px;margin-top:8px}
.wp-foot .hint{font-size:11px;color:var(--c-text-3)}

/* meta 三栏 */
.meta3{display:flex;margin:10px 0 0;background:#fff;border:1px solid var(--c-line-soft);
  border-radius:12px;overflow:hidden;box-shadow:var(--sh-sm)}
.meta3 .m{flex:1;padding:8px 0;text-align:center}
.meta3 .m+.m{border-left:1px solid var(--c-line-soft)}
.meta3 .k{font-size:10px;color:var(--c-text-3);letter-spacing:.5px}
.meta3 .v{font-family:var(--kai);font-size:15px;font-weight:400;margin-top:1px}

.block-t{font-size:12.5px;font-weight:600;color:var(--c-text-2);margin:12px 0 7px;
  display:flex;align-items:center;gap:6px}
.block-t::before{content:"";width:3px;height:11px;border-radius:2px;background:var(--c-primary)}
.block-t .more{margin-left:auto;font-size:11px;font-weight:400;color:var(--c-text-3)}
.words{display:flex;flex-wrap:wrap;gap:6px}
.word{display:flex;align-items:center;gap:5px;background:#fff;border:1px solid var(--c-line-soft);
  border-radius:10px;padding:6px 10px;font-family:var(--kai);font-size:15px;box-shadow:var(--sh-sm)}

/* 按钮 */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:none;border-radius:999px;
  font-family:var(--font);font-weight:600;cursor:pointer}
.btn-p{height:44px;padding:0 24px;background:var(--c-primary);color:#fff;font-size:15.5px;
  box-shadow:0 2px 8px rgba(217,79,61,.24);transition:transform .18s var(--ease),background .18s}
.btn-p:active{background:var(--c-primary-deep);transform:scale(.96)}
.btn-s{height:44px;padding:0 20px;background:#fff;color:var(--c-primary);border:1.5px solid #F3C9C2;font-size:15px}
.btn-g{height:36px;padding:0 14px;background:transparent;color:var(--c-text-2);font-size:14px;border-radius:10px}
.btn-r{height:44px;padding:0 24px;background:linear-gradient(180deg,#F7C553,#F2B230);color:#6B4708;
  font-size:15.5px;font-weight:700;box-shadow:var(--sh-gold)}
.btn-full{width:100%}
.btn-row{display:flex;gap:8px;margin-top:8px}

/* ---------- 平板详情 ---------- */
.tpad{display:flex;height:100%;padding:0 32px 32px;gap:28px}
.tpad .left{width:44%;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-top:6px}
.tpad .right{width:56%;padding-top:6px}
.tpad .write-panel{width:100%}
.tpad .tz{width:268px;height:268px}
.tpad .tz .zi{font-size:204px}
.tpad .strokes{width:268px;gap:8px}
.tpad .strokes .st .zi{font-size:52px}
.tpad .pg.lg{height:52px}
.tpad .pg.lg i{font-size:32px;line-height:50px;top:-2.8px}
.tpad .meta3 .v{font-size:19px}
.tpad .words{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.tpad .word{justify-content:space-between}

/* ---------- 激励 ---------- */
.panel{background:#fff;border:1px solid var(--c-line-soft);border-radius:18px;padding:22px;box-shadow:var(--sh-sm)}
.panel+.panel{margin-top:16px}
.panel h3{font-size:15px;font-weight:600;margin-bottom:3px}
.panel .sub{font-size:12.5px;color:var(--c-text-3);margin-bottom:15px}
.row{display:flex;gap:18px;flex-wrap:wrap;align-items:center}
.star-fly{animation:fly 2.8s var(--ease) infinite}
@keyframes fly{
  0%{transform:translate(0,0) rotate(0deg) scale(.4);opacity:0}
  18%{transform:translate(0,-6px) rotate(-10deg) scale(1.15);opacity:1}
  70%{transform:translate(34px,-46px) rotate(14deg) scale(.9);opacity:1}
  100%{transform:translate(52px,-70px) rotate(20deg) scale(.5);opacity:0}
}
.seals{display:grid;grid-template-columns:repeat(6,1fr);gap:11px}
.seal{aspect-ratio:1;border-radius:11px;display:grid;place-items:center;position:relative;
  font-family:var(--kai);font-size:20px;font-weight:700}
.seal.on{background:var(--c-primary);color:#fff;border:2px solid var(--c-primary-deep);
  box-shadow:0 3px 10px rgba(217,79,61,.28);transform:rotate(-4deg)}
.seal.off{border:2px dashed var(--c-line);color:#D6CEC1;background:#FCFAF6;font-size:15px;font-weight:500}
.seal-lbl{font-size:10px;color:var(--c-text-3);text-align:center;margin-top:5px}
.levels{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}
.lv{border-radius:13px;padding:13px 6px;text-align:center;border:1px solid var(--c-line-soft);background:#FCFAF6}
.lv.on{background:#fff;box-shadow:var(--sh-md);border-color:transparent}
.lv .badge{width:42px;height:42px;border-radius:50%;margin:0 auto 7px;display:grid;place-items:center;
  font-family:var(--kai);font-size:15px;font-weight:700;color:#fff}
.lv .nm{font-size:12.5px;font-weight:600}
.lv .cg{font-size:10.5px;color:var(--c-text-3);margin-top:1px}
.bar{height:7px;border-radius:999px;background:var(--c-line-soft);overflow:hidden}
.bar i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--c-primary),var(--c-gold))}

/* 标签 */
.tag{height:23px;padding:0 9px;border-radius:7px;font-size:12px;font-weight:500;display:inline-flex;align-items:center;gap:4px}
.tag-multi{background:var(--c-primary-light);color:var(--c-primary-deep)}
.tag-lesson{background:var(--c-line-soft);color:var(--c-text-3)}
.tag-new{background:var(--c-success-light);color:#3E7F6C}
.pill{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1px solid var(--c-line);
  border-radius:999px;padding:6px 13px;font-size:13px}

/* 组件陈列 */
.comp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.comp-card{background:#fff;border:1px solid var(--c-line-soft);border-radius:16px;padding:18px;box-shadow:var(--sh-sm)}
.comp-card .lbl{font-size:11.5px;color:var(--c-text-3);letter-spacing:.6px;margin-bottom:12px;font-weight:600}
.comp-card .stack{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.fake-input{width:100%;height:44px;border:1.5px solid var(--c-line);border-radius:12px;display:flex;align-items:center;
  padding:0 14px;font-size:14px;color:#B8B0A4;background:#fff}
.fake-input.focus{border-color:var(--c-primary);box-shadow:0 0 0 3px rgba(217,79,61,.10);color:var(--c-text)}

/* 说明条 */
.callout{display:flex;gap:12px;background:var(--c-warn-light);border-radius:14px;padding:14px 16px;
  font-size:13.5px;color:#7A5A1E;line-height:1.75;margin-top:14px}
.callout b{color:#5E4413}
.callout .ic{flex:none;font-size:15px;line-height:1.5}
.dont{background:var(--c-primary-wash);color:#8C3A2C}
.dont b{color:#7A2E22}
.info{background:#EFF4F8;color:#2E4A5E}
.info b{color:#1F3543}
.ok{background:var(--c-success-light);color:#2F6B5A}
.ok b{color:#215245}

.legend{display:flex;gap:22px;flex-wrap:wrap;font-size:12.5px;color:var(--c-text-3);margin-top:16px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:middle}

table.cmp{width:100%;border-collapse:collapse;font-size:13px}
table.cmp th,table.cmp td{border:1px solid var(--c-line);padding:8px 11px;text-align:left;vertical-align:top}
table.cmp th{background:#FCFAF6;font-weight:600;font-size:12.5px}
table.cmp td code{font-family:ui-monospace,monospace;font-size:12px;color:var(--c-primary-deep)}

@media (max-width:900px){
  body{padding:24px 16px 60px}
  .doc-head h1{font-size:26px}
  .phone{width:340px;height:700px}
  .tablet{width:100%;max-width:486px}
}
</style>
</head>
<body>
<div class="wrap">

  <div class="doc-head">
    <div class="kicker">UI Design · v1.01</div>
    <h1>zika 字卡 · <em>纸上识字</em></h1>
    <p>v1.00 是「视觉语言探索稿」——只定了色板、质感、组件风格和激励机制，页面布局是占位性的，没按真实信息密度排。v1.01 是<b>正式 UI 稿</b>：列表页与详情页重新排版，汉字全部改用楷体，笔顺分解紧贴书写动画。</p>
    <div class="meta">
      <span class="tag tag-multi">儿童向 · 不幼稚</span>
      <span class="tag tag-new">纸墨中国风</span>
      <span class="tag tag-lesson">手机 375-430 · 平板 810-1080</span>
    </div>
  </div>

  <div class="callout ok">
    <span class="ic">✓</span>
    <div><b>v1.01 三处修订</b>　① 列表卡片加四线三格拼音 + 发音按钮，不进详情页就能听；② 详情页重排为「书写区面板」，拼音/田字格/笔顺分解成组，不再松散漂浮；③ 汉字全部改楷体——原版 Web 用的就是楷体，v1.00 我错改成黑体了。</div>
